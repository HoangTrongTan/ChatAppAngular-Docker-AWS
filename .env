# ─────────────────────────────────────────────
# Angular Chat App — Environment Variables
# ─────────────────────────────────────────────

# Backend REST API base URL
API_URL=http://localhost:3000/api

# ASP.NET Core SignalR Hub URL
HUB_URL=http://localhost:3000/hubs/chat

# Default chat room
DEFAULT_ROOM=general
