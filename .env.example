# ─────────────────────────────────────────────
# Angular Chat App — Environment Variables Example
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Backend REST API base URL
API_URL=http://your-backend-host:3000/api

# ASP.NET Core SignalR Hub URL
HUB_URL=http://your-backend-host:3000/hubs/chat

# Default chat room name
DEFAULT_ROOM=general
