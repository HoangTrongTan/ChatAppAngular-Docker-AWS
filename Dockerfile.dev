FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./

# dùng ci vì cài nhanh hơn install, dùng ci thì phải đi kèm với package-lock.json
RUN npm ci && npm cache clean --force

COPY . .

EXPOSE 4200

# Bắt buộc có cờ --host 0.0.0.0 (để Docker map port ra ngoài) và --poll 2000 (để bắt file change qua VMware)
CMD ["npx", "ng", "serve", "--host", "0.0.0.0", "--port", "4200", "--poll", "2000"]
# CMD ["npm", "start"]